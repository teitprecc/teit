
#include <stdio.h>
#include <stdlib.h>

struct Student {
    int id;
    char name[30];
    float cgpa;
};

int main() {
    struct Student *s, temp;
    int n, i, j, key, low, high, mid;

    printf("Enter number of students: ");
    scanf("%d", &n);

    s = malloc(n * sizeof(struct Student));

    for(i = 0; i < n; i++) {
        printf("\nEnter ID, Name and CGPA: ");
        scanf("%d %s %f", &s[i].id, s[i].name, &s[i].cgpa);
    }

    // Expand memory
    s = realloc(s, (n + 1) * sizeof(struct Student));

    printf("\nEnter new student details: ");
    scanf("%d %s %f", &s[n].id, s[n].name, &s[n].cgpa);
    n++;

    // Sort by ID
    for(i = 0; i < n; i++)
        for(j = i + 1; j < n; j++)
            if(s[i].id > s[j].id) {
                temp = s[i];
                s[i] = s[j];
                s[j] = temp;
            }

    printf("\nEnter ID to search: ");
    scanf("%d", &key);

    // Linear Search
    for(i = 0; i < n; i++)
        if(s[i].id == key) {
            printf("Linear Search: %s %.2f\n", s[i].name, s[i].cgpa);
            break;
        }

    // Binary Search
    low = 0;
    high = n - 1;

    while(low <= high) {
        mid = (low + high) / 2;

        if(s[mid].id == key) {
            printf("Binary Search: %s %.2f\n", s[mid].name, s[mid].cgpa);
            break;
        }
        else if(s[mid].id < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    free(s);
    return 0;
}
